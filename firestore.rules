rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verifica que el usuario haya iniciado sesión
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar: obtiene el householdId del usuario actual leyendo su documento en "users"
    function getUserHouseholdId() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userDoc) && ('householdId' in get(userDoc).data)
        ? get(userDoc).data.householdId
        : null;
    }

    // Colección de Usuarios:
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Subcolección privada: plan de sueldo mensual (solo el propio usuario)
      match /salary_config/{monthKey} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Subcolección privada: notificaciones individuales (alertas stop loss)
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Colección de Hogares (Households)
    match /households/{householdId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        householdId == getUserHouseholdId() ||
        (resource != null && 'members' in resource.data && resource.data.members.hasAny([request.auth.uid])) ||
        (
          request.resource.data.members != null &&
          request.resource.data.members.hasAny([request.auth.uid])
        )
      );
      allow delete: if isAuthenticated() && (
        householdId == getUserHouseholdId() ||
        (resource != null && 'members' in resource.data && resource.data.members.hasAny([request.auth.uid]))
      );
      
      match /notifications/{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Colecciones estrictamente personales (mobility_sessions, mobility_expenses, notes)
    match /{collection}/{document} {
      allow read, write: if isAuthenticated() &&
        collection in ['mobility_sessions', 'mobility_expenses', 'notes'] &&
        (
          (resource == null && request.resource.data.userId == request.auth.uid) ||
          (resource != null && resource.data.userId == request.auth.uid)
        );
    }

    // Colecciones de la aplicación (con soporte de hogar compartido o datos personales)
    match /{collection}/{document} {
      allow read, delete: if isAuthenticated() &&
        collection in [
          'transactions', 'cards', 'supermarket_items', 'fresh_purchases',
          'services', 'planner_categories', 'contributions',
          'savings_transactions', 'savings_goals', 'savings_asset_prices',
          'savings_stop_losses', 'savings_carteras', 'merchant_aliases'
        ] &&
        (
          // Consulta o documento por Hogar (si el usuario pertenece a este hogar)
          (resource.data.householdId != null && resource.data.householdId == getUserHouseholdId()) ||
          // Consulta o documento Personal (por userId o ownerId)
          (resource.data.userId == request.auth.uid) ||
          (resource.data.ownerId == request.auth.uid) ||
          (resource.data.uid == request.auth.uid)
        );

      allow create: if isAuthenticated() &&
        collection in [
          'transactions', 'cards', 'supermarket_items', 'fresh_purchases',
          'services', 'planner_categories', 'contributions',
          'savings_transactions', 'savings_goals', 'savings_asset_prices',
          'savings_stop_losses', 'savings_carteras', 'merchant_aliases'
        ] &&
        (
          (request.resource.data.householdId != null && request.resource.data.householdId == getUserHouseholdId()) ||
          (request.resource.data.userId == request.auth.uid) ||
          (request.resource.data.ownerId == request.auth.uid)
        );

      allow update: if isAuthenticated() &&
        collection in [
          'transactions', 'cards', 'supermarket_items', 'fresh_purchases',
          'services', 'planner_categories', 'contributions',
          'savings_transactions', 'savings_goals', 'savings_asset_prices',
          'savings_stop_losses', 'savings_carteras', 'merchant_aliases'
        ] &&
        (
          (resource.data.householdId != null && resource.data.householdId == getUserHouseholdId()) ||
          (resource.data.userId == request.auth.uid) ||
          (resource.data.ownerId == request.auth.uid)
        );
    }
  }
}
